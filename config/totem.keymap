//                                                         ▀▀▀   █   ▀▀▀   █   ▀▀▀   ▀   ▀▀▀
//                                                               █      ▄▄▄█▄▄▄    █   █
//                                                               ▀      █  █  █     █▄█
//                                                             ▀▀▀▀▀    █  █  █      ▀
//                                                                      ▀  ▀  ▀
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>

// Layer definitions with descriptive names
#define BASE   0
#define SYM    1
#define NUM    2
#define FUN    3
#define NAV    4
#define GAME   5

// Mod combinations
#define MEH LC(LA(LSHIFT))
#define HYPER LC(LA(LS(LGUI)))

/ {
    macros {
        // Screenshot macros (tap=⌘⇧4, hold=⌘⇧3)
        scr_area: scr_area {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(LS(N4))>;
        };

        scr_full: scr_full {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(LS(N3))>;
        };

        // Macros for accented characters
        a_circ: a_circ {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp RALT>
                     , <&macro_tap &kp N6>
                     , <&macro_release &kp RALT>
                     , <&macro_tap &kp A>;
        };

        e_circ: e_circ {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp RALT>
                     , <&macro_tap &kp N6>
                     , <&macro_release &kp RALT>
                     , <&macro_tap &kp E>;
        };

        i_circ: i_circ {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp RALT>
                     , <&macro_tap &kp N6>
                     , <&macro_release &kp RALT>
                     , <&macro_tap &kp I>;
        };

        u_circ: u_circ {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp RALT>
                     , <&macro_tap &kp N6>
                     , <&macro_release &kp RALT>
                     , <&macro_tap &kp U>;
        };

        o_circ: o_circ {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp RALT>
                     , <&macro_tap &kp N6>
                     , <&macro_release &kp RALT>
                     , <&macro_tap &kp O>;
        };

        i_diae: i_diae {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp RALT>
                     , <&macro_tap &kp J>
                     , <&macro_release &kp RALT>;
        };

        n_tilde: n_tilde {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp RALT>
                     , <&macro_tap &kp N>
                     , <&macro_release &kp RALT>;
        };

        e_acute: e_acute {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp RALT>
                     , <&macro_tap &kp E>
                     , <&macro_release &kp RALT>;
        };

        e_grave: e_grave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp RALT>
                     , <&macro_tap &kp GRAVE>
                     , <&macro_release &kp RALT>
                     , <&macro_tap &kp E>;
        };

        a_grave: a_grave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp RALT>
                     , <&macro_tap &kp GRAVE>
                     , <&macro_release &kp RALT>
                     , <&macro_tap &kp A>;
        };

        u_grave: u_grave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp RALT>
                     , <&macro_tap &kp GRAVE>
                     , <&macro_release &kp RALT>
                     , <&macro_tap &kp U>;
        };

        oe_lig: oe_lig {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp RALT>
                     , <&macro_tap &kp X>
                     , <&macro_release &kp RALT>;
        };

        ae_lig: ae_lig {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp RALT>
                     , <&macro_tap &kp Z>
                     , <&macro_release &kp RALT>;
        };

        c_cedil: c_cedil {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp RALT>
                     , <&macro_tap &kp COMMA>
                     , <&macro_release &kp RALT>;
        };

        nbsp: nbsp {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp RALT &kp LSHIFT>
                     , <&macro_tap &kp SPACE>
                     , <&macro_release &kp RALT &kp LSHIFT>;
        };

        digraph_eu: digraph_eu {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp E &kp U>;
        };

        digraph_ue: digraph_ue {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp U &kp E>;
        };
    };

    behaviors {
        // Home row mods with hold-trigger-key-positions (permissive hold for opposite hand)
        // Acts as modifier only when opposite hand key is pressed AND this key is still held
        // Allows fast same-hand typing without accidental mod activation
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <
                // Right hand keys (for left hand home row mods)
                5 6 7 8 9
                15 16 17 18 19
                25 26 27 28 29
                35 36 37
                // Left hand keys (for right hand home row mods)
                0 1 2 3 4
                10 11 12 13 14
                20 21 22 23 24
                32 33 34
                // Thumb keys
                30 31 32 33 34 35 36 37
            >;
            hold-trigger-on-release;
        };

        // Layer-tap behavior for thumbs - hold on other key press
        ltq: layer_tap_quick {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <125>;
            bindings = <&mo>, <&kp>;
            hold-trigger-on-release;
        };

        // Mod-tap for thumbs - hold on other key press
        mtq: mod_tap_quick {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <125>;
            bindings = <&kp>, <&kp>;
            hold-trigger-on-release;
        };

        // Screenshot tap-dance
        td_scr: tap_dance_screenshot {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&scr_area>, <&scr_full>;
        };

        // Leader key setup (requires zmk-leader-key module)
        leader: leader {
            compatible = "zmk,behavior-leader-key";
            #binding-cells = <0>;

            // Vowels with circumflex (â ê î ô û)
            lead_a_circ {
                sequence = <A>;
                bindings = <&a_circ>;
            };

            lead_e_circ {
                sequence = <COMMA>;  // E position in Colemak-DH
                bindings = <&e_circ>;
            };

            lead_i_circ {
                sequence = <Y>;
                bindings = <&i_circ>;
            };

            lead_u_circ {
                sequence = <U>;
                bindings = <&u_circ>;
            };

            lead_o_circ {
                sequence = <O>;
                bindings = <&o_circ>;
            };

            // ï (i with diaeresis)
            lead_i_diae {
                sequence = <I>;
                bindings = <&i_diae>;
            };

            // ñ (n with tilde)
            lead_n_tilde {
                sequence = <K>;
                bindings = <&n_tilde>;
            };

            // é (e acute)
            lead_e_acute {
                sequence = <R>;
                bindings = <&e_acute>;
            };

            // è (e grave)
            lead_e_grave {
                sequence = <S>;
                bindings = <&e_grave>;
            };

            // à (a grave) - mapped to F key
            lead_a_grave {
                sequence = <F>;
                bindings = <&a_grave>;
            };

            // ù (u grave)
            lead_u_grave {
                sequence = <P>;
                bindings = <&u_grave>;
            };

            // œ (oe ligature)
            lead_oe_lig {
                sequence = <L>;
                bindings = <&oe_lig>;
            };

            // æ (ae ligature)
            lead_ae_lig {
                sequence = <Z>;
                bindings = <&ae_lig>;
            };

            // ç (c cedilla)
            lead_c_cedil {
                sequence = <C>;
                bindings = <&c_cedil>;
            };

            // Non-breaking space
            lead_nbsp {
                sequence = <SPACE>;
                bindings = <&nbsp>;
            };

            // En dash (–)
            lead_endash {
                sequence = <D>;
                bindings = <&kp MINUS>;
            };

            // Common digraphs
            lead_eu {
                sequence = <N>;
                bindings = <&digraph_eu>;
            };

            lead_ue {
                sequence = <E>;
                bindings = <&digraph_ue>;
            };

            // ( left parenthesis - mapped to T key
            lead_lparen {
                sequence = <T>;
                bindings = <&kp LPAR>;
            };

            // ) right parenthesis
            lead_rparen {
                sequence = <G>;
                bindings = <&kp RPAR>;
            };
        };
    };

    combos {
        compatible = "zmk,combos";

        // X+C -> switch to gaming layer
        combo_xc_to_game {
            timeout-ms = <20>;
            key-positions = <22 23>;
            bindings = <&to GAME>;
            layers = <BASE>;
        };

        // C+D on base -> no-op (prevents accidental activation)
        combo_cd_noop {
            timeout-ms = <20>;
            key-positions = <23 24>;
            bindings = <&none>;
            layers = <BASE>;
        };

        // S+C on gaming layer -> return to base (S is at position 13 in game layer)
        combo_sc_exit_game {
            timeout-ms = <20>;
            key-positions = <13 23>;
            bindings = <&to BASE>;
            layers = <GAME>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "Base";
            bindings = <
                          &kp LG(TAB)      &kp W            &kp F            &kp P            &kp B                &kp J            &kp L            &kp U            &kp Y            &kp QMARK
                          &hm LCTRL A      &hm LALT R       &hm MEH S        &hm HYPER T      &lt NAV G            &lt NAV M        &hm HYPER N      &hm MEH E        &hm LGUI I       &hm RCTRL O
            &lt FUN Q     &kp Z            &kp X            &kp C            &kp D            &kp V                &kp K            &kp H            &kp COMMA        &leader          &kp DOT          &lt FUN SQT
                                                            &mtq LGUI DEL    &mtq LSHIFT BSPC &ltq SYM ESC         &ltq SYM RET     &ltq NUM SPACE   &mtq LALT TAB
            >;
        };

        sym_layer {
            label = "Sym";
            bindings = <
                          &trans           &kp CARET        &kp QMARK        &kp ASTRK        &none                &none            &kp RPAR         &kp RBKT         &kp RBRC         &kp SEMI
                          &kp EXCL         &kp UNDER        &kp BSLH         &kp EQUAL        &kp DLLR             &kp AT           &kp LPAR         &kp LBKT         &kp LBRC         &kp COLON
            &kp COMMA     &kp PRCNT        &none            &kp PIPE         &kp TILDE        &kp HASH             &kp PLUS         &kp MINUS        &kp LT           &kp GT           &kp FSLH         &kp GRAVE
                                                            &trans           &trans           &trans               &trans           &trans           &trans
            >;
        };

        num_layer {
            label = "Num";
            bindings = <
                          &kp EQUAL        &kp N7           &kp N8           &kp N9           &kp FSLH             &kp HOME         &kp PG_DN        &kp PG_UP        &kp END          &td_scr
                          &kp MINUS        &kp N4           &kp N5           &kp N6           &kp PLUS             &kp LEFT         &kp DOWN         &kp UP           &kp RIGHT        &mkp RCLK
            &mt LALT BSPC &kp N0           &kp N1           &kp N2           &kp N3           &kp ASTRK            &mmv MOVE_LEFT   &mmv MOVE_DOWN   &mmv MOVE_UP     &mmv MOVE_RIGHT  &mkp LCLK        &none
                                                            &trans           &mt LALT BSPC    &trans               &trans           &trans           &trans
            >;
        };

        fun_layer {
            label = "Fun";
            bindings = <
                          &none            &kp F7           &kp F8           &kp F9           &kp F12              &none            &kp K_COPY       &kp K_PASTE      &none            &none
                          &none            &kp F4           &kp F5           &kp F6           &kp F11              &kp C_PP         &kp C_VOL_UP     &kp C_VOL_DN     &kp C_MUTE       &kp C_BRI_UP
            &none         &none            &kp F1           &kp F2           &kp F3           &kp F10              &kp C_PREV       &kp K_BACK       &kp K_FORWARD    &kp C_NEXT       &kp C_BRI_DN     &none
                                                            &trans           &trans           &trans               &trans           &trans           &trans
            >;
        };

        nav_layer {
            label = "Nav";
            bindings = <
                          &none            &kp LC(LA(LS(N1))) &kp LC(LA(LS(N2))) &kp LC(LA(LS(N3))) &kp LC(LA(LS(N4)))    &none            &none            &none            &none            &none
                          &none            &none            &none            &none            &none                       &kp LC(LA(LS(H))) &kp LC(LA(LS(J))) &kp LC(LA(LS(K))) &kp LC(LA(LS(L))) &none
            &none         &none            &kp LC(LA(LS(Q))) &kp LC(LA(LS(W))) &kp LC(LA(LS(E))) &none                       &none            &none            &none            &none            &none            &none
                                                            &kp LGUI         &none            &none                       &kp LGUI         &none            &none
            >;
        };

        game_layer {
            label = "Game";
            bindings = <
                          &kp N1           &kp N2           &kp B            &kp N3           &kp N4               &none            &none            &none            &none            &none
                          &hm LCTRL Q      &kp A            &kp W            &kp D            &kp E                &none            &none            &none            &none            &none
            &none         &hm LSHIFT Z     &kp X            &kp S            &kp C            &kp F                &kp K            &kp H            &kp COMMA        &kp DOT          &kp FSLH         &kp SQT
                                                            &kp V            &kp SPACE        &kp R                &kp RET          &kp BSPC         &kp ESC
            >;
        };
    };
};
